\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Bootstrap 95\% confidence intervals for test MSE, $R^2$, and Spearman $\rho $ across all models (10{,}000 bootstrap resamples). $^\dagger $Full-data model: (256, 256, 128) architecture, dropout 0.35, trained on all 3068 samples without validation split, evaluated on all 1326 test samples. \textit  {Note:} Point estimates for scalar NN models may differ from Table\nobreakspace  {}\ref  {tab:comparison} because the bootstrap procedure retrains each model with a single random initialization, whereas Table\nobreakspace  {}\ref  {tab:comparison} reports the best configuration selected from 40 candidates.\relax }}{19}{table.caption.27}\protected@file@percent }
\newlabel{tab:bootstrap}{{9}{19}{Bootstrap 95\% confidence intervals for test MSE, $R^2$, and Spearman $\rho $ across all models (10{,}000 bootstrap resamples). $^\dagger $Full-data model: (256, 256, 128) architecture, dropout 0.35, trained on all 3068 samples without validation split, evaluated on all 1326 test samples. \textit {Note:} Point estimates for scalar NN models may differ from Table~\ref {tab:comparison} because the bootstrap procedure retrains each model with a single random initialization, whereas Table~\ref {tab:comparison} reports the best configuration selected from 40 candidates.\relax }{table.caption.27}{}}
